<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>silver_catalogo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Pipeline Silver do Catalogo com deduplicacao, validacao de obrigatorios e data, conversao de tipos e carga de silver.catalogo.</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 05:21:00.000</created_date>
    <modified_date>2026/09/27 05:21:00.000</modified_date>
  </info>
  <transform>
    <type>TableInput</type>
    <name>Ler bronze.catalogo</name>
    <sql>SELECT conteudo_id, titulo, tipo, categoria, nivel, carga_horaria_min, data_publicacao, descricao, autor, origem_arquivo, execucao_id FROM bronze.catalogo;</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <connection>pg_desafio2</connection>
    <lookup/>
    <sql_from_file/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>48</xloc>
      <yloc>160</yloc>
    </GUI>
    <description>Le os campos da Bronze como origem da camada Silver.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>UniqueRowsByHashSet</type>
    <name>Remover duplicados (conteudo_id)</name>
    <store_values>N</store_values>
    <fields>
      <field>
        <name>conteudo_id</name>
      </field>
    </fields>
    <reject_duplicate_row>N</reject_duplicate_row>
    <error_description/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>224</xloc>
      <yloc>160</yloc>
    </GUI>
    <description>Conserva uma linha por conteudo_id.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Padronizar tipos numericos</name>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <meta>
        <name>conteudo_id</name>
        <rename>conteudo_id</rename>
        <type>Integer</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
        <roundingType>half_even</roundingType>
      </meta>
      <meta>
        <name>carga_horaria_min</name>
        <rename>carga_horaria_min</rename>
        <type>Integer</type>
        <length>-2</length>
        <precision>-2</precision>
        <storage_type/>
        <conversion_mask/>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale/>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
        <roundingType>half_even</roundingType>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>400</xloc>
      <yloc>160</yloc>
    </GUI>
    <description>Converte somente os campos numericos.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>JavaFilter</type>
    <name>Validar registro</name>
    <condition>conteudo_id != null &amp;&amp; titulo != null &amp;&amp; !titulo.trim().isEmpty() &amp;&amp; tipo != null &amp;&amp; !tipo.trim().isEmpty() &amp;&amp; categoria != null &amp;&amp; !categoria.trim().isEmpty() &amp;&amp; nivel != null &amp;&amp; !nivel.trim().isEmpty() &amp;&amp; carga_horaria_min != null &amp;&amp; data_publicacao != null &amp;&amp; data_publicacao.matches("\\d{4}-\\d{2}-\\d{2}") &amp;&amp; descricao != null &amp;&amp; !descricao.trim().isEmpty() &amp;&amp; autor != null &amp;&amp; !autor.trim().isEmpty() &amp;&amp; origem_arquivo != null &amp;&amp; !origem_arquivo.trim().isEmpty() &amp;&amp; execucao_id != null &amp;&amp; !execucao_id.trim().isEmpty() &amp;&amp; Integer.parseInt(data_publicacao.substring(5,7)) >= 1 &amp;&amp; Integer.parseInt(data_publicacao.substring(5,7)) &lt;= 12 &amp;&amp; Integer.parseInt(data_publicacao.substring(8,10)) >= 1 &amp;&amp; ((Integer.parseInt(data_publicacao.substring(5,7)) == 2 &amp;&amp; Integer.parseInt(data_publicacao.substring(8,10)) &lt;= ((Integer.parseInt(data_publicacao.substring(0,4)) % 4 == 0 &amp;&amp; (Integer.parseInt(data_publicacao.substring(0,4)) % 100 != 0 || Integer.parseInt(data_publicacao.substring(0,4)) % 400 == 0)) ? 29 : 28)) || ((Integer.parseInt(data_publicacao.substring(5,7)) == 4 || Integer.parseInt(data_publicacao.substring(5,7)) == 6 || Integer.parseInt(data_publicacao.substring(5,7)) == 9 || Integer.parseInt(data_publicacao.substring(5,7)) == 11) &amp;&amp; Integer.parseInt(data_publicacao.substring(8,10)) &lt;= 30) || ((Integer.parseInt(data_publicacao.substring(5,7)) == 1 || Integer.parseInt(data_publicacao.substring(5,7)) == 3 || Integer.parseInt(data_publicacao.substring(5,7)) == 5 || Integer.parseInt(data_publicacao.substring(5,7)) == 7 || Integer.parseInt(data_publicacao.substring(5,7)) == 8 || Integer.parseInt(data_publicacao.substring(5,7)) == 10 || Integer.parseInt(data_publicacao.substring(5,7)) == 12) &amp;&amp; Integer.parseInt(data_publicacao.substring(8,10)) &lt;= 31))</condition>
    <send_true_to>Converter data_publicacao</send_true_to>
    <send_false_to>Exportar quarentena CSV</send_false_to>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>608</xloc>
      <yloc>160</yloc>
    </GUI>
    <description>Valida campos obrigatorios e data_publicacao antes de qualquer conversao.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SelectValues</type>
    <name>Converter data_publicacao</name>
    <fields>
      <select_unspecified>Y</select_unspecified>
      <meta>
        <name>data_publicacao</name>
        <rename>data_publicacao</rename>
        <type>Date</type>
        <length>-1</length>
        <precision>-1</precision>
        <storage_type/>
        <conversion_mask>yyyy-MM-dd</conversion_mask>
        <date_format_lenient>N</date_format_lenient>
        <date_format_locale>pt_BR</date_format_locale>
        <date_format_timezone/>
        <lenient_string_to_number>N</lenient_string_to_number>
        <decimal_symbol/>
        <grouping_symbol/>
        <currency_symbol/>
        <encoding/>
      </meta>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>832</xloc>
      <yloc>112</yloc>
    </GUI>
    <description>Converte a data somente depois da validacao.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Gravar silver.catalogo</name>
    <connection>pg_desafio2</connection>
    <schema>silver</schema>
    <table>catalogo</table>
    <commit>100</commit>
    <truncate>N</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
