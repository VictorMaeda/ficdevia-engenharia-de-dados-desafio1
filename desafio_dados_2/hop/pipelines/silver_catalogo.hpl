      <field>
        <stream_name>data_publicacao</stream_name>
        <column_name>data_publicacao</column_name>
      </field>
      <field>
        <stream_name>descricao</stream_name>
        <column_name>descricao</column_name>
      </field>
      <field>
        <stream_name>autor</stream_name>
        <column_name>autor</column_name>
      </field>
      <field>
        <stream_name>origem_arquivo</stream_name>
        <column_name>origem_arquivo</column_name>
      </field>
      <field>
        <stream_name>execucao_id</stream_name>
        <column_name>execucao_id</column_name>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1056</xloc>
      <yloc>112</yloc>
    </GUI>
    <description>Somente registros validos chegam a silver.catalogo.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
