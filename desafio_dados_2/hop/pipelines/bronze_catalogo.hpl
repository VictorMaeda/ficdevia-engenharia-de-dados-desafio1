<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version/>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>bronze_catalogo</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Ingestao bruta do catalogo de conteudos (CSV) para bronze.catalogo, sem transformacoes destrutivas, com campos de auditoria (RF20).</description>
    <extended_description/>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/26 00:00:00.000</created_date>
    <modified_date>2026/09/26 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>CsvInput</type>
    <name>Ler catalogo (CSV)</name>
    <filename>${SOURCE_CATALOGO_CSV}</filename>
    <filename_field/>
    <include_filename>N</include_filename>
    <rownum_field/>
    <header>Y</header>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <encoding>UTF-8</encoding>
    <newline_possible>N</newline_possible>
    <schemaDefinition/>
    <ignoreFields>N</ignoreFields>
    <fields>
      <field>
        <name>conteudo_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>titulo</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>tipo</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>categoria</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>nivel</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>carga_horaria_min</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>data_publicacao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>descricao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
      <field>
        <name>autor</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>both</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>128</xloc>
      <yloc>144</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>GetVariable</type>
    <name>Adicionar auditoria</name>
    <fields>
      <field>
        <name>origem_arquivo</name>
        <variable>${SOURCE_CATALOGO_CSV}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
      <field>
        <name>execucao_id</name>
        <variable>${EXECUCAO_ID}</variable>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>none</trim_type>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>352</xloc>
      <yloc>144</yloc>
    </GUI>
    <description>Acrescenta origem do arquivo e id de execucao vindos de variaveis do ambiente Hop (RF20/RF15). data_hora_ingestao fica a cargo do DEFAULT now() da tabela.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>TableOutput</type>
    <name>Gravar bronze.catalogo</name>
    <connection>pg_desafio2</connection>
    <schema>bronze</schema>
    <table>catalogo</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <fields/>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>576</xloc>
      <yloc>144</yloc>
    </GUI>
    <description/>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Ler catalogo (CSV)</from>
      <to>Adicionar auditoria</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Adicionar auditoria</from>
      <to>Gravar bronze.catalogo</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
