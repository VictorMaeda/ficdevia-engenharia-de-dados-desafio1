  </info>
  <transform>
    <type>TableInput</type>
    <name>Ler bronze.interacoes</name>
    <sql>SELECT 
       (conteudo_json -> '' -> 0 ->> 'usuario_id') AS usuario_id, 
       (conteudo_json -> '' -> 0 ->> 'conteudo_id') AS conteudo_id, 
       (conteudo_json -> '' -> 0 ->> 'tipo_interacao') AS tipo_interacao, 
       (conteudo_json -> '' -> 0 ->> 'data_hora') AS data_hora, 
       (conteudo_json -> '' -> 0 ->> 'tempo_consumido') AS tempo_consumido,
       (conteudo_json -> '' -> 0 ->> 'percentual_conclusao') AS percentual_conclusao, 
       (conteudo_json -> '' -> 0 ->> 'avaliacao_atribuida') AS avaliacao_atribuida, 
       execucao_id
FROM bronze.interacoes
WHERE execucao_id = '${EXECUCAO_ID}'</sql>
    <limit>0</limit>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
