  <transform>
    <type>ScriptValueMod</type>
    <name>Preparar quarentena</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var origem = "interacoes";
var mensagem_erro = "Falha de validacao na Silver: " + (regra_violada != null ? regra_violada : "Erro desconhecido");
// Correcao: new Date() do Rhino gera um NativeDate, que o Hop nao
// consegue converter para java.sql.Timestamp (ClassCastException em
// "Selecionar campos quarentena" e na gravacao do estado de execucao).
// Construir o objeto Java diretamente resolve o problema.
var data_erro = new java.sql.Timestamp(java.lang.System.currentTimeMillis());
        </jsScript_script>
      </jsScript>
    </jsScripts>
