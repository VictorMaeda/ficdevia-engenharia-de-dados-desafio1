    <name>silver_interacoes</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Padroniza bronze.interacoes, remove duplicidade por (usuario_id, conteudo_id, tipo_interacao, data_hora), valida referencia contra silver.catalogo e regras de negocio, e separa aprovados (silver.interacoes) de rejeitados (quarentena.interacoes). RF21.</description>
    <extended_description/>
    <created_user>-</created_user>
