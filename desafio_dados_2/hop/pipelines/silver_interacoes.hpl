  <transform>
    <type>ScriptValueMod</type>
    <name>Validar regras</name>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var regra_violada = null;

var u_id = (usuario_id != null) ? usuario_id.toString().trim() : "";
var c_id = (conteudo_id != null) ? conteudo_id.toString().trim() : "";
var t_int = (tipo_interacao != null) ? tipo_interacao.toString().trim().toLowerCase() : "";
var p_conc = (percentual_conclusao != null) ? percentual_conclusao.toString().trim() : "";
var a_atr = (avaliacao_atribuida != null) ? avaliacao_atribuida.toString().trim() : "";

if (u_id == "") {
    regra_violada = "usuario_id ausente";
} else if (c_id == "") {
    regra_violada = "conteudo_id ausente";
} else if (titulo_ref == null) {
    regra_violada = "conteudo_id inexistente no catalogo";
} else if (!t_int.match(/^(inicio|in[ií]cio|visualiza[cç][aã]o|conclus[aã]o|avalia[cç][aã]o|curtida|compartilhamento)$/)) {
    regra_violada = "tipo_interacao invalido";
} else if (p_conc != "" &amp;&amp; !p_conc.match(/^(100(\.0+)?|[0-9]{1,2}(\.[0-9]+)?)$/)) {
    regra_violada = "percentual_conclusao invalido";
} else if (a_atr != "" &amp;&amp; !a_atr.match(/^[1-5]$/)) {
    regra_violada = "avaliacao invalida";
}
        </jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
