      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
setlocal

echo === RF24 - EXPORTACAO PARQUET VIA APACHE HOP ===
echo Diretorio: %CD%
echo.

REM ------------------------------------------------------------
REM Carrega variaveis locais.
REM ------------------------------------------------------------

if not exist ".env" (
    echo ERRO: arquivo .env nao encontrado em %CD%
    exit /b 2
)

for /f "usebackq eol=# tokens=1,* delims==" %%A in (".env") do (
    if not "%%A"=="" set "%%A=%%B"
)

if not defined POSTGRES_PASSWORD (
    if defined DB_PASSWORD (
        set "POSTGRES_PASSWORD=%DB_PASSWORD%"
    )
)

if not defined POSTGRES_PASSWORD (
    echo ERRO: DB_PASSWORD ou POSTGRES_PASSWORD nao foi definido.
    exit /b 2
)

REM ------------------------------------------------------------
REM Valida Python.
REM ------------------------------------------------------------

if not exist ".venv\Scripts\python.exe" (
    echo ERRO: Python da venv nao encontrado.
    exit /b 2
)

REM ------------------------------------------------------------
REM Executa exportacao para area runtime.
REM ------------------------------------------------------------

".venv\Scripts\python.exe" ^
    "beam\exportar_parquet.py" ^
    --csv-output "runtime\silver\interacoes.csv" ^
    --parquet-output "runtime\silver\interacoes_parquet"

set "RESULTADO=%ERRORLEVEL%"

echo.
echo Exit code da exportacao Parquet: %RESULTADO%

exit /b %RESULTADO%</script>
      <name>Exportar Parquet</name>
      <type>SHELL</type>
      <attributes/>
      <xloc>1072</xloc>
      <yloc>176</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
      <arg_from_previous>N</arg_from_previous>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <exec_per_row>N</exec_per_row>
      <set_append_logfile>N</set_append_logfile>
      <insertScript>Y</insertScript>
      <script>@echo off
setlocal

echo === RF25 - APACHE BEAM DIRECTRUNNER VIA APACHE HOP ===
echo Diretorio: %CD%
echo.

REM ------------------------------------------------------------
REM Valida o ambiente Python do Desafio 2.
REM ------------------------------------------------------------

if not exist ".venv\Scripts\python.exe" (
    echo ERRO: Python da venv nao encontrado.
    exit /b 2
)

REM ------------------------------------------------------------
REM Valida a entrada Parquet produzida pelo RF24.
REM ------------------------------------------------------------

if not exist "runtime\silver\interacoes_parquet" (
    echo ERRO: Diretorio Parquet de entrada nao encontrado.
    exit /b 2
)

REM ------------------------------------------------------------
REM Limpa somente a saida operacional anterior do Beam.
REM ------------------------------------------------------------

if exist "runtime\beam" (
    rmdir /s /q "runtime\beam"
)

mkdir "runtime\beam"

REM ------------------------------------------------------------
REM Executa a mesma regra do RF25 com DirectRunner.
REM ------------------------------------------------------------

".venv\Scripts\python.exe" "beam\pipeline_beam.py" --input "runtime\silver\interacoes_parquet\*\*.parquet" --output "runtime\beam\agregacao_conteudo" --runner=DirectRunner

set "RESULTADO=%ERRORLEVEL%"

echo.
echo Exit code do Beam DirectRunner: %RESULTADO%

exit /b %RESULTADO%</script>
      <name>Beam DirectRunner</name>
      <type>SHELL</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>176</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arguments/>
