      <xloc>1072</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
      <message>Pipeline interrompido devido a falha em uma etapa dependente.</message>
      <loglevel>Error</loglevel>
      <name>Falha - abortar workflow</name>
      <description/>
      <type>ABORT</type>
      <attributes/>
      <xloc>1232</xloc>
      <yloc>48</yloc>
      <parallel>N</parallel>
      <attributes_hac/>
    </action>
    <action>
