<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>orquestracao_bronze_silver</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Executa em sequencia as pipelines Bronze (catalogo, interacoes, comentarios) e depois as Silver (catalogo, interacoes, comentarios). Interrompe a cadeia se qualquer etapa falhar (RF22) e registra a falha em log (RF23).</description>
  <extended_description/>
  <created_user>-</created_user>
  <modified_user>-</modified_user>
  <created_date>2026/09/26 00:00:00.000</created_date>
  <modified_date>2026/09/26 00:00:00.000</modified_date>
  <workflow_version/>
  <parameters>
    <parameter>
      <name>EXECUCAO_ID</name>
      <description>Identificador unico desta execucao (ex.: timestamp ou UUID), propagado para todas as pipelines Bronze e Silver.</description>
      <default_value/>
    </parameter>
  </parameters>
  <actions>
    <action>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
