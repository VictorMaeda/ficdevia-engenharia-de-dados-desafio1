# ==============================================================================
# DESAFIO PRÁTICO 2 — FIC DEV IA: FUNDAMENTOS DE DADOS PARA IA
# ARQUIVO: desafio_dados_2/.env.example
# FINALIDADE: Template de variáveis de ambiente. Copie para .env e preencha.
# ATENÇÃO: O arquivo .env NUNCA deve ser commitado. Ele está no .gitignore.
# RF15: Separação de senhas e segredos do código-fonte e dos arquivos versionados.
# ==============================================================================

# ─── PostgreSQL (banco principal do Desafio 2) ────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=desafio_dados
POSTGRES_USER=desafio_user
POSTGRES_PASSWORD=troque_esta_senha

# ─── LGPD — Proteção de Dados Pessoais (RF33) ────────────────────────────────
# Chave usada para pseudonimização determinística (HMAC-SHA256).
# NUNCA compartilhe nem inclua em repositórios.
LGPD_PEPPER_KEY=pepper_fic_dev_ia_2026_segredo

# Salt base utilizado para hashing irreversível.
# NUNCA compartilhe nem inclua em repositórios.
LGPD_SALT_SECRET=salt_corporativo_desafio2_k9

# ─── OpenMetadata (RF27/28/29) ────────────────────────────────────────────────
# URL da instância OpenMetadata. Deixe em branco se não disponível.
OPENMETADATA_HOST=http://localhost:8585
OPENMETADATA_JWT_TOKEN=

# ─── Apache Hop (RF20/21/22) ──────────────────────────────────────────────────
# Caminho de instalação local do Apache Hop (usado nos scripts de ambiente)
# HOP_HOME=/opt/hop
