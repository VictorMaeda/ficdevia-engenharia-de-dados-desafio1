# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (ver .gitignore).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=desafio_dados
POSTGRES_USER=desafio_user
POSTGRES_PASSWORD=troque_esta_senha

# Variáveis do MongoDB (RF07). Usuário/senha ficam em branco se a
# instância local não exigir autenticação (padrão do docker-compose).
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=desafio_dados
MONGO_USER=
MONGO_PASSWORD=
