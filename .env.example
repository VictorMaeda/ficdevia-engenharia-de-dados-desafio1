# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo ".env" NUNCA deve ser commitado (ver .gitignore).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=desafio_dados
POSTGRES_USER=desafio_user
POSTGRES_PASSWORD=troque_esta_senha

# Variáveis do MongoDB (RF07). Usuário/senha ficam em branco se a
# instância local não exigir autenticação (padrão do docker-compose).
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=desafio_dados
MONGO_USER=
MONGO_PASSWORD=

# ============================================================
# Apache Superset
# ============================================================

SUPERSET_PORT=8088

# Banco interno de metadados do Superset
SUPERSET_META_DB=superset
SUPERSET_META_USER=superset
SUPERSET_META_PASSWORD=troque_esta_senha

# Chave secreta do Superset
SUPERSET_SECRET_KEY=troque_esta_chave_por_uma_chave_aleatoria

# Usuário administrador inicial do Superset
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=troque_esta_senha
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=Superset
SUPERSET_ADMIN_EMAIL=admin@example.com